{
  "name": "dsh-muse-code",
  "version": "0.1.0",
  "description": "Muse Code inside DeepSeek Harness: a composer switch that opens a live Muse Code panel in the right sidebar, with the same session readable and controllable from chat tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "muse",
    "muse-code",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Jiasheng Fu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixJiashengFu/dsh-muse-code.git"
  },
  "homepage": "https://github.com/FelixJiashengFu/dsh-muse-code#readme",
  "bugs": {
    "url": "https://github.com/FelixJiashengFu/dsh-muse-code/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
